{
  "name": "drogalink-tarefas",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "ACCESS_TEAM_URL": "https://zaureliojr.cloudflareaccess.com",
    "ACCESS_AUD": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drogalink-tarefas",
      "database_id": "2280292d-befb-4b81-950a-745a55769d65",
      "migrations_table": "tarefas_migrations"
    }
  ]
}
