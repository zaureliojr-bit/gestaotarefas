{
  "name": "drogalink-tarefas",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "previews": {},
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "AUTH_MODE": "internal",
    "ACCESS_TEAM_URL": "https://zaureliojr.cloudflareaccess.com",
    "ACCESS_AUD": "b984aaeafd474ef49550c527a14ac79e77e571d4163ec46aa127aeaf28092289"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drogalink-tarefas",
      "database_id": "2280292d-befb-4b81-950a-745a55769d65",
      "migrations_table": "tarefas_migrations"
    }
  ],
  "routes": [
    {
      "pattern": "tarefas.drogalink.com.br",
      "custom_domain": true
    }
  ]
}
